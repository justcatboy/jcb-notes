---
// Отдельные страницы из src/content/pages: /stack/.
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { page } from '../markdown';
import { downloadName } from '../site';

export const getStaticPaths = (async () =>
  (await getCollection('pages')).map((entry) => ({ params: { page: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: CollectionEntry<'pages'> };
const { Content } = await render(entry);
const md = `${entry.id}.md`;
const section = entry.id === 'stack' ? 'stack' : undefined;
---

<Base title={entry.data.title} description={entry.data.description} section={section} md={md}>
  <article>
    <h1>{entry.data.title}</h1>
    <div class="meta"><a class="dl" href={page(md)} download={downloadName('pages', entry.id)}>Скачать .md</a></div>
    <div class="prose"><Content /></div>
  </article>
</Base>
