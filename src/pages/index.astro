---
// Главная — витрина обеих частей сайта: о чём он, три последние записи, стандарты. Полная лента — /blog/.
import Calendar from '../components/Calendar.astro';
import { day } from '../header';
import Base from '../layouts/Base.astro';
import { page } from '../markdown';
import { getPosts, getStandards } from '../site';

const posts = (await getPosts()).slice(0, 3);
const standards = (await getStandards()).flat();
---

<Base description="Личный блог о разном и стандарты jcb-* для моих проектов.">
  <div class="split">
    <div class="split-main">
      <div class="lead">
        <h1>Личный блог</h1>
        <p>Пишу о разном: о своих проектах и разработке, об инструментах и обо всём, что интересно.</p>
        <p>
          Отдельная часть сайта — стандарты <code>jcb-*</code>: правила, которые выросли из моих проектов. Проект принимает
          их с версией и проверяет себя по ним.
        </p>
      </div>

      <section class="home-section">
        <h2 class="home-title">Последние записи</h2>
        <ul class="compact">
          {
            posts.map((post) => (
              <li>
                <time datetime={day(post.data.date)}>{day(post.data.date)}</time>
                <a href={page(`blog/${post.id}/`)}>{post.data.title}</a>
              </li>
            ))
          }
        </ul>
        <a class="more" href={page('blog/')}>все записи →</a>
      </section>

      <section class="home-section">
        <h2 class="home-title">Стандарты</h2>
        <ul class="compact">
          {
            standards.map((entry) => (
              <li>
                <span class:list={['v', { draft: entry.data.version.startsWith('v0.') }]}>{entry.data.version}</span>
                <a href={page(`standards/${entry.id}/`)}>{entry.data.title}</a>
                <span class="code">{entry.data.code}</span>
              </li>
            ))
          }
        </ul>
        <a class="more" href={page('standards/')}>все стандарты и как ими пользоваться →</a>
      </section>
    </div>
    <aside class="side">
      <Calendar />
      {
        // Шуточная «реклама» — с классами ad*, их прячут блокировщики. Рядом — запасной блок с нейтральными
        // классами: его показывает скрипт ниже, если блокировщик спрятал рекламу.
        [1, 2].map(() => (
          <div class="joke-slot">
            <div class="ad" role="note">
              <span class="ad-label">реклама</span>
              <p>Здесь могла быть ваша реклама</p>
              <span class="ad-note">закажите прямо сейчас!</span>
            </div>
            <div class="blocked-box" role="note" hidden>
              <svg class="blocked-box-icon" viewBox="0 0 48 56" width="56" height="66" aria-hidden="true">
                <path d="M24 3 L44 10 V27 C44 40 35 49 24 53 C13 49 4 40 4 27 V10 Z" />
                <path d="M14 37 L19 20 L24 37 M16 31 H22" />
                <path d="M28 20 V37 H31 C36 37 38 33 38 28.5 C38 24 36 20 31 20 Z" />
                <path d="M9 44 L40 13" />
              </svg>
              <span class="blocked-box-sub">рекламу съел блокировщик</span>
            </div>
          </div>
        ))
      }
    </aside>
  </div>
</Base>

<script>
  // Блокировщик рекламы прячет .ad / .ad-label / .ad-note (иногда не сразу) — тогда вместо них запасной блок.
  const hidden = (el: Element | null) =>
    !el || !(el as HTMLElement).offsetHeight || getComputedStyle(el).display === 'none' || getComputedStyle(el).visibility === 'hidden';
  const check = () => {
    for (const slot of document.querySelectorAll('.joke-slot')) {
      const ad = slot.querySelector('.ad');
      if (hidden(ad) || hidden(slot.querySelector('.ad-label')) || hidden(slot.querySelector('.ad-note'))) {
        ad?.setAttribute('hidden', '');
        slot.querySelector<HTMLElement>('.blocked-box')!.hidden = false;
      }
    }
  };
  // Только в npm run dev: /?adblock прячет рекламу тем же правилом, что uBlock, — проверить запасной блок.
  // В сборку для сайта не попадает: import.meta.env.DEV при build — false, и ветку вырезает.
  if (import.meta.env.DEV && new URLSearchParams(location.search).has('adblock')) {
    const style = document.createElement('style');
    style.textContent = '.ad-label, .ad-note { display: none !important; }';
    document.head.append(style);
  }
  setTimeout(check, 300);
  setTimeout(check, 1500);
</script>
