---
// Все посты и все метки.
import PostList from '../../components/PostList.astro';
import Tags from '../../components/Tags.astro';
import Base from '../../layouts/Base.astro';
import { countTags, getPosts } from '../../site';

const posts = await getPosts();
const tags = countTags(posts);
---

<Base title="Блог" description="Все записи блога и метки." section="blog">
  <h1>Блог</h1>
  <div class="meta"><Tags tags={tags.map(([tag]) => tag)} counts={new Map(tags)} /></div>
  <PostList posts={posts} />
</Base>
