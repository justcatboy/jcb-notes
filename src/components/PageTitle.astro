---
// Заголовок Starlight, под ним — шапка из полей (код, версия, дата) и «Скачать .md»
// (файл отдаёт src/pages/[...slug].md.ts).
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { getCollection } from 'astro:content';
import { headerLine } from '../header';

const { entry } = Astro.locals.starlightRoute;
const header = headerLine(entry.data);
// Кнопка — только там, где есть файл: тот же список, из которого делаются .md (у 404 — нет).
const docs = new Set((await getCollection('docs')).map((doc) => doc.id));
const entryId = entry.id || 'index'; // у главной Starlight отдаёт пустой id, в коллекции она — index
const id = docs.has(entryId) ? entryId : null;
const href = id && `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${id}.md`;
// standards/dotenv → jcb-dotenv.md, standards/dotenv/appendix-1 → jcb-dotenv-appendix-1.md
const filename = id && `${id === 'index' ? 'jcb-notes' : id.replace(/^standards\//, 'jcb-').replaceAll('/', '-')}.md`;
---

<Default />
{
  (header || href) && (
    <div class="meta">
      {header && <span class="header">{header}</span>}
      {href && <a class="download" href={href} download={filename}>Скачать .md</a>}
    </div>
  )
}

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
  }
  .header {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .download {
    margin-inline-start: auto; /* к правому краю, даже когда шапки нет */
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .download:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
</style>
