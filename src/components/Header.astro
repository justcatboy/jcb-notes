---
// Шапка: название, вкладки разделов (темы starlight-sidebar-topics), справа — поиск значком, ссылка на
// GitHub и тема. На телефоне вкладки — в выдвижном меню (Sidebar.astro). Версия сайта — в подвале (Footer.astro).
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const tabs = Astro.locals.starlightSidebarTopics.topics.map((topic) => ({
  label: topic.label,
  href: topic.link,
  current: topic.isCurrent,
}));
---

<div class="header">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <nav class="tabs sl-hidden md:sl-flex print:hidden" aria-label="Разделы">
    {tabs.map((tab) => <a href={tab.href} aria-current={tab.current ? 'page' : undefined}>{tab.label}</a>)}
  </nav>
  <div class="right-group sl-flex print:hidden">
    <Search />
    <div class="sl-hidden md:sl-flex extras">
      <div class="sl-flex social-icons"><SocialIcons /></div>
      <ThemeSelect />
    </div>
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
  }
  .title-wrapper {
    min-width: 0;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }
  .tabs {
    gap: 1.5rem;
    margin-inline-start: 1.5rem;
    align-self: stretch;
  }
  .tabs a {
    display: flex;
    align-items: center;
    border-bottom: 2px solid transparent;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .tabs a:hover {
    color: var(--sl-color-white);
  }
  .tabs a[aria-current='page'] {
    border-bottom-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .right-group {
    align-items: center;
    gap: 1rem;
    margin-inline-start: auto;
  }
  .extras,
  .social-icons {
    align-items: center;
    gap: 1rem;
  }
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
</style>
