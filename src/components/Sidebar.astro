---
// Меню слева: темы starlight-sidebar-topics здесь не показываем — они вкладками в шапке (Header.astro).
// На телефоне вкладок в шапке нет — тогда они сверху выдвижного меню.
import Default from '@astrojs/starlight/components/Sidebar.astro';

const { topics, isPageWithTopic } = Astro.locals.starlightSidebarTopics;
---

{
  isPageWithTopic && (
    <nav class="mobile-tabs" aria-label="Разделы">
      {topics.map((topic) => (
        <a href={topic.link} aria-current={topic.isCurrent ? 'page' : undefined}>
          {topic.label}
        </a>
      ))}
    </nav>
  )
}
<Default><slot /></Default>

<style>
  .mobile-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }
  .mobile-tabs a {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .mobile-tabs a[aria-current='page'] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  /* На широком экране вкладки — в шапке. */
  @media (min-width: 50rem) {
    .mobile-tabs {
      display: none;
    }
  }
</style>
