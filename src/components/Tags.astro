---
import { page } from '../markdown';

interface Props {
  tags: string[];
  counts?: Map<string, number>;
}

const { tags, counts } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="tags">
      {tags.map((tag) => (
        <span>
          <a href={page(`blog/tags/${tag}/`)}>{tag}</a>
          {counts && <span class="n"> {counts.get(tag)}</span>}
        </span>
      ))}
    </div>
  )
}
