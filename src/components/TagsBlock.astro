---
import { page } from '../markdown';
import { countTags, getPosts } from '../site';
import SideBlock from './SideBlock.astro';

interface Props {
  current?: string;
}

const tags = countTags(await getPosts());
---

<SideBlock title="Метки">
  <ul>
    {
      tags.map(([tag, n]) => (
        <li>
          {tag === Astro.props.current ? <span aria-current="page">#{tag}</span> : <a href={page(`blog/tags/${tag}/`)}>#{tag}</a>}
          <span class="n"> {n}</span>
        </li>
      ))
    }
  </ul>
</SideBlock>
<SideBlock title="Подписка">
  <ul>
    <li><a href={page('rss.xml')}>RSS</a></li>
  </ul>
</SideBlock>
