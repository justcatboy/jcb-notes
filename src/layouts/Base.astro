---
// Каркас всех страниц: <head>, шапка с разделами, подвал с версией сайта.
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/jetbrains-mono/400-italic.css';
import '../styles/site.css';
import { page } from '../markdown';
import { REPO, SITE_TITLE } from '../site';
import { siteTag, siteVersion } from '../version';

interface Props {
  title?: string;
  description?: string;
  /** Раздел в шапке: blog, standards, stack. */
  section?: 'blog' | 'standards' | 'stack';
  /** Путь .md этой страницы (без ведущего /) — ссылка для Claude в <head>. */
  md?: string;
}

const { title, description, section, md } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const versionHref = siteTag && `${REPO}/tree/${siteTag}`;
const nav = [
  { id: 'blog', label: 'блог', href: page('') },
  { id: 'standards', label: 'стандарты', href: page('standards/') },
  { id: 'stack', label: 'стек', href: page('stack/') },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={page('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={page('rss.xml')} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={page('llms.txt')} />
    {md && <link rel="alternate" type="text/markdown" href={page(md)} />}
    <meta property="og:title" content={title ?? SITE_TITLE} />
    {description && <meta property="og:description" content={description} />}
    <script is:inline>
      // Тема до отрисовки, чтобы не мигало: выбранная вручную — из localStorage, иначе — системная.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <div class="col">
      <header class="s-head">
        <a class="s-logo" href={page('')}>{SITE_TITLE.toLowerCase()}</a>
        <nav class="s-nav" aria-label="Разделы">
          {nav.map((item) => <a href={item.href} aria-current={item.id === section ? 'page' : undefined}>{item.label}</a>)}
          <button class="theme" type="button" id="theme-toggle" aria-label="Сменить тему">◐</button>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="s-foot">
        <span>{SITE_TITLE}</span>
        {versionHref ? <a href={versionHref} title="Версия сайта — тег в репозитории">{siteVersion}</a> : <span>{siteVersion}</span>}
        <a href={REPO}>исходники</a>
        <a href={`${REPO}/blob/main/LICENSE`}>CC BY 4.0</a>
        <a href={page('rss.xml')}>rss</a>
        <a href={page('llms.txt')} title="Оглавление для Claude и других LLM">llms.txt</a>
      </footer>
    </div>
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch {}
      });
    </script>
  </body>
</html>
